FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap curl tmux \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app

# Install strix deps using the real pyproject.toml (sandbox extras)
COPY junk/pyproject.toml pyproject.toml
COPY junk/uv.lock uv.lock
RUN echo "# Sandbox" > README.md && mkdir -p strix && touch strix/__init__.py
RUN uv sync --frozen --no-dev --extra sandbox

# Copy strix source
COPY strix/ strix/

ENV PYTHONPATH=/app
ENV STRIX_SANDBOX_MODE=true

EXPOSE 48081

CMD ["/app/.venv/bin/python", "-m", "strix.runtime.tool_server", "--token", "secret123", "--host", "0.0.0.0", "--port", "48081"]
